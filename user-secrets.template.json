{
  "ConnectionStrings": {
    "AppDatabase": "Server=localhost,1433;Database=badjockeys;User Id=sa;Password=<BJK_SQL_PASSWORD from bjk-identity-server/.env>;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Authentication": {
    "Authority": "https://localhost:5001"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Media": {
    "Storage": {
      "ServiceUrl": "http://localhost:9090",
      "AccessKeyId": "local",
      "SecretAccessKey": "local",
      "OriginalsBucket": "bjk-dev-originals",
      "PublicBucket": "bjk-dev-public",
      "PublicBaseUrl": "http://localhost:9090/bjk-dev-public/"
    },
    "Queue": {
      "QueueName": "media.process"
    },
    "Processing": {
      "FfmpegPath": "ffmpeg",
      "FfprobePath": "ffprobe"
    }
  },
  "Captcha": {
    "//": "Cloudflare's public test secret, which accepts every token (the public report form sends X-Captcha-Token).",
    "TurnstileSecretKey": "1x0000000000000000000000000000000AA"
  },
  "Safety": {
    "//": "Local development only: true (the default) needs the identity server's age_verified claim on writes.",
    "RequireAgeVerification": false
  },
  "Messaging": {
    "//": "Optional; defaults shown. The queues are tables in the messaging schema of AppDatabase (see docs/messaging.md).",
    "PollingInterval": "00:00:01",
    "UserEventsQueue": "bjk-core.user-events",
    "MediaEventsQueue": "bjk-core.media-events"
  }
}
