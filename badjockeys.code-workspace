{
  "folders": [
    {
      "name": "bjk-core",
      "path": "."
    },
    {
      "name": "bjk-identity-server",
      "path": "../bjk-identity-server"
    },
    {
      "name": "bjk-modules",
      "path": "../bjk-modules"
    },
    {
      "name": "bjk-mobile",
      "path": "../bjk-mobile"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/bin": true,
      "**/obj": true,
      "**/node_modules": true,
      "**/.next": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-dotnettools.csdevkit",
      "ms-mssql.mssql",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build identity server",
        "type": "process",
        "command": "dotnet",
        "args": [
          "build",
          "${workspaceFolder:bjk-identity-server}/src/BJK.Idsrv.Host/BJK.Idsrv.Host.csproj",
          "/property:GenerateFullPaths=true",
          "/consoleloggerparameters:NoSummary"
        ],
        "problemMatcher": "$msCompile",
        "presentation": {
          "reveal": "silent"
        }
      },
      {
        "label": "Build API",
        "type": "process",
        "command": "dotnet",
        "args": [
          "build",
          "${workspaceFolder:bjk-core}/src/BJK.Core.Api/BJK.Core.Api.csproj",
          "/property:GenerateFullPaths=true",
          "/consoleloggerparameters:NoSummary"
        ],
        "problemMatcher": "$msCompile",
        "presentation": {
          "reveal": "silent"
        }
      },
      {
        "label": "Build media worker",
        "type": "process",
        "command": "dotnet",
        "args": [
          "build",
          "${workspaceFolder:bjk-core}/src/BJK.Core.MediaWorker/BJK.Core.MediaWorker.csproj",
          "/property:GenerateFullPaths=true",
          "/consoleloggerparameters:NoSummary"
        ],
        "problemMatcher": "$msCompile",
        "presentation": {
          "reveal": "silent"
        }
      },
      {
        "label": "Start SQL Server",
        "type": "shell",
        "command": "docker compose up -d --wait",
        "options": {
          "cwd": "${workspaceFolder:bjk-identity-server}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "silent"
        }
      },
      {
        "label": "Start S3Mock",
        "type": "shell",
        "command": "docker compose up -d",
        "options": {
          "cwd": "${workspaceFolder:bjk-core}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "silent"
        }
      },
      {
        "label": "Start Docker services",
        "dependsOn": [
          "Start SQL Server",
          "Start S3Mock"
        ],
        "problemMatcher": []
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Identity server",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "Build identity server",
        "program": "${workspaceFolder:bjk-identity-server}/src/BJK.Idsrv.Host/bin/Debug/net10.0/BJK.Idsrv.Host.dll",
        "cwd": "${workspaceFolder:bjk-identity-server}/src/BJK.Idsrv.Host",
        "launchSettingsFilePath": "${workspaceFolder:bjk-identity-server}/src/BJK.Idsrv.Host/Properties/launchSettings.json",
        "launchSettingsProfile": "https",
        "console": "integratedTerminal",
        "stopAtEntry": false
      },
      {
        "name": "API",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "Build API",
        "program": "${workspaceFolder:bjk-core}/src/BJK.Core.Api/bin/Debug/net10.0/BJK.Core.Api.dll",
        "cwd": "${workspaceFolder:bjk-core}/src/BJK.Core.Api",
        "launchSettingsFilePath": "${workspaceFolder:bjk-core}/src/BJK.Core.Api/Properties/launchSettings.json",
        "launchSettingsProfile": "https",
        "console": "integratedTerminal",
        "stopAtEntry": false
      },
      {
        "name": "Media worker",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "Build media worker",
        "program": "${workspaceFolder:bjk-core}/src/BJK.Core.MediaWorker/bin/Debug/net10.0/BJK.Core.MediaWorker.dll",
        "cwd": "${workspaceFolder:bjk-core}/src/BJK.Core.MediaWorker",
        "launchSettingsFilePath": "${workspaceFolder:bjk-core}/src/BJK.Core.MediaWorker/Properties/launchSettings.json",
        "launchSettingsProfile": "worker",
        "console": "integratedTerminal",
        "stopAtEntry": false
      },
      {
        "name": "Web app",
        "type": "node-terminal",
        "request": "launch",
        "command": "npm run dev",
        "cwd": "${workspaceFolder:bjk-core}/src/web",
        "env": {
          "NODE_EXTRA_CA_CERTS": "${userHome}/.aspnet/dev-cert.pem"
        },
        "serverReadyAction": {
          "pattern": "Local:\\s+(https?://\\S+)",
          "uriFormat": "%s",
          "action": "openExternally"
        }
      }
    ],
    "compounds": [
      {
        "name": "Bad Jockeys (all)",
        "configurations": [
          "Identity server",
          "API",
          "Media worker",
          "Web app"
        ],
        "stopAll": true,
        "preLaunchTask": "Start Docker services"
      }
    ]
  }
}
