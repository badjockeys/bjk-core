{
  "folders": [
    {
      "name": "bjk-core",
      "path": "."
    },
    {
      "name": "bjk-identity-server",
      "path": "../bjk-identity-server"
    },
    {
      "name": "bjk-modules",
      "path": "../bjk-modules"
    },
    {
      "name": "bjk-mobile",
      "path": "../bjk-mobile"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/bin": true,
      "**/obj": true,
      "**/node_modules": true,
      "**/.next": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-dotnettools.csdevkit",
      "ms-mssql.mssql",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build identity server",
        "type": "process",
        "command": "dotnet",
        "args": [
          "build",
          "${workspaceFolder:bjk-identity-server}/src/BJK.Idsrv.Host/BJK.Idsrv.Host.csproj",
          "/property:GenerateFullPaths=true",
          "/consoleloggerparameters:NoSummary"
        ],
        "problemMatcher": "$msCompile",
        "presentation": {
          "reveal": "silent"
        }
      },
      {
        "label": "Build API",
        "type": "process",
        "command": "dotnet",
        "args": [
          "build",
          "${workspaceFolder:bjk-core}/src/BJK.Core.Api/BJK.Core.Api.csproj",
          "/property:GenerateFullPaths=true",
          "/consoleloggerparameters:NoSummary"
        ],
        "problemMatcher": "$msCompile",
        "presentation": {
          "reveal": "silent"
        }
      },
      {
        "label": "Build media worker",
        "type": "process",
        "command": "dotnet",
        "args": [
          "build",
          "${workspaceFolder:bjk-core}/src/BJK.Core.MediaWorker/BJK.Core.MediaWorker.csproj",
          "/property:GenerateFullPaths=true",
          "/consoleloggerparameters:NoSummary"
        ],
        "problemMatcher": "$msCompile",
        "presentation": {
          "reveal": "silent"
        }
      },
      {
        "label": "Docker for all apps",
        "type": "process",
        "command": "node",
        "args": [
          "${workspaceFolder:bjk-core}/scripts/start-docker.mjs",
          "--open-reports"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": false
        },
        "hide": true
      },
      {
        "label": "Docker for identity server",
        "type": "process",
        "command": "node",
        "args": [
          "${workspaceFolder:bjk-core}/scripts/start-docker.mjs"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": false
        },
        "hide": true
      },
      {
        "label": "Prepare identity server",
        "dependsOn": [
          "Docker for identity server",
          "Build identity server"
        ],
        "dependsOrder": "sequence",
        "problemMatcher": [],
        "hide": true
      },
      {
        "label": "Docker for API",
        "type": "process",
        "command": "node",
        "args": [
          "${workspaceFolder:bjk-core}/scripts/start-docker.mjs"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": false
        },
        "hide": true
      },
      {
        "label": "Prepare API",
        "dependsOn": [
          "Docker for API",
          "Build API"
        ],
        "dependsOrder": "sequence",
        "problemMatcher": [],
        "hide": true
      },
      {
        "label": "Docker for media worker",
        "type": "process",
        "command": "node",
        "args": [
          "${workspaceFolder:bjk-core}/scripts/start-docker.mjs"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": false
        },
        "hide": true
      },
      {
        "label": "Prepare media worker",
        "dependsOn": [
          "Docker for media worker",
          "Build media worker",
          "Wait for API (media worker)"
        ],
        "dependsOrder": "sequence",
        "problemMatcher": [],
        "hide": true
      },
      {
        "label": "Wait for identity server and API",
        "type": "process",
        "command": "node",
        "args": [
          "${workspaceFolder:bjk-core}/scripts/wait-for-apps.mjs",
          "identity",
          "api"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "silent",
          "panel": "dedicated"
        },
        "hide": true
      },
      {
        "label": "Wait for API (media worker)",
        "type": "process",
        "command": "node",
        "args": [
          "${workspaceFolder:bjk-core}/scripts/wait-for-apps.mjs",
          "api"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "silent",
          "panel": "dedicated"
        },
        "hide": true
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Identity server",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "Prepare identity server",
        "program": "${workspaceFolder:bjk-identity-server}/src/BJK.Idsrv.Host/bin/Debug/net10.0/BJK.Idsrv.Host.dll",
        "cwd": "${workspaceFolder:bjk-identity-server}/src/BJK.Idsrv.Host",
        "launchSettingsFilePath": "${workspaceFolder:bjk-identity-server}/src/BJK.Idsrv.Host/Properties/launchSettings.json",
        "launchSettingsProfile": "https",
        "console": "integratedTerminal",
        "stopAtEntry": false
      },
      {
        "name": "API",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "Prepare API",
        "program": "${workspaceFolder:bjk-core}/src/BJK.Core.Api/bin/Debug/net10.0/BJK.Core.Api.dll",
        "cwd": "${workspaceFolder:bjk-core}/src/BJK.Core.Api",
        "launchSettingsFilePath": "${workspaceFolder:bjk-core}/src/BJK.Core.Api/Properties/launchSettings.json",
        "launchSettingsProfile": "https",
        "console": "integratedTerminal",
        "stopAtEntry": false
      },
      {
        "name": "Media worker",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "Prepare media worker",
        "program": "${workspaceFolder:bjk-core}/src/BJK.Core.MediaWorker/bin/Debug/net10.0/BJK.Core.MediaWorker.dll",
        "cwd": "${workspaceFolder:bjk-core}/src/BJK.Core.MediaWorker",
        "launchSettingsFilePath": "${workspaceFolder:bjk-core}/src/BJK.Core.MediaWorker/Properties/launchSettings.json",
        "launchSettingsProfile": "worker",
        "console": "integratedTerminal",
        "stopAtEntry": false
      },
      {
        "name": "Web app",
        "type": "node-terminal",
        "request": "launch",
        "command": "npm run dev",
        "cwd": "${workspaceFolder:bjk-core}/src/web",
        "env": {
          "NODE_EXTRA_CA_CERTS": "${userHome}/.aspnet/dev-cert.pem"
        },
        "serverReadyAction": {
          "pattern": "Local:\\s+(https?://\\S+)",
          "uriFormat": "%s",
          "action": "openExternally"
        },
        "preLaunchTask": "Wait for identity server and API",
        "resolveSourceMapLocations": [
          "${workspaceFolder:bjk-core}/src/web/**",
          "!**/node_modules/**",
          "!**/turbopack*/**",
          "!**/%5Bturbopack%5D/**"
        ]
      }
    ],
    "compounds": [
      {
        "name": "Bad Jockeys",
        "configurations": [
          "Identity server",
          "API",
          "Media worker",
          "Web app"
        ],
        "stopAll": true,
        "preLaunchTask": "Docker for all apps"
      }
    ]
  }
}
