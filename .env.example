# Copy to .env (git-ignored) and choose your own passwords, or let the setup (node scripts/setup-local.mjs) do it.
# SQL Server needs 8+ characters with upper case, lower case, a digit and a symbol.
BJK_SQL_PASSWORD=Choose-A-Str0ng-Password
# The read-only login for the reports (scripts/sql/reporting). The setup fills this in; any letters and digits will do.
BJK_REPORTING_PASSWORD=
# Elasticsearch's "elastic" user: sign in to Kibana (http://localhost:5601) with it. Letters and digits.
BJK_ELASTIC_PASSWORD=
# The password Kibana itself uses to reach Elasticsearch (the kibana_system user). Letters and digits.
BJK_KIBANA_PASSWORD=
# Encrypts Kibana's saved alert rules and connectors: 32 or more letters and digits, never changed afterwards.
BJK_KIBANA_ENCRYPTION_KEY=
