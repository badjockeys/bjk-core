# Copy to .env (git-ignored) and choose your own passwords, or let the setup (node scripts/setup-local.mjs) do it.
# SQL Server needs 8+ characters with upper case, lower case, a digit and a symbol.
BJK_SQL_PASSWORD=Choose-A-Str0ng-Password
# The read-only login for the reports (scripts/sql/reporting). The setup fills this in; any letters and digits will do.
BJK_REPORTING_PASSWORD=
# The read-only login for Ask Bad Jockeys (the AI chat): the incident tables only. The setup fills this in.
BJK_CHAT_PASSWORD=
# The "elastic" user's password: what YOU sign in to Kibana (http://localhost:5601) and Elasticsearch with,
# username elastic. Letters and digits.
BJK_ELASTIC_PASSWORD=
# Not for signing in: the password the Kibana server itself uses behind the scenes to reach Elasticsearch
# (the built-in kibana_system user). Letters and digits.
BJK_KIBANA_SYSTEM_PASSWORD=
# Encrypts Kibana's saved alert rules and connectors: 32 or more letters and digits, never changed afterwards.
BJK_KIBANA_ENCRYPTION_KEY=
# The folder holding your .NET user secrets (the setup fills this in): ~/.microsoft/usersecrets on a Mac,
# %APPDATA%/Microsoft/UserSecrets on Windows (forward slashes). The released build (docker compose --profile release)
# mounts it into the app containers, so they read the same secrets.json files as F5.
BJK_USER_SECRETS_DIR=
# Optional: which builds the release profile runs. tag is a bjk-core commit SHA (the API, media worker and web
# images) and identity_tag a bjk-identity-server one; the first 7 characters are enough. Without them, latest.
# tag=latest
# identity_tag=latest
