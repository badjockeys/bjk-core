# Copy to .env (git-ignored) and choose your own password.
# SQL Server needs 8+ characters with upper case, lower case, a digit and a symbol.
BJK_SQL_PASSWORD=Choose-A-Str0ng-Password
# The read-only login Grafana uses for the reports (scripts/sql/reporting). The setup fills this in; any letters and
# digits will do.
BJK_REPORTING_PASSWORD=
