<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>BJK.Core.Api</RootNamespace>
    <UserSecretsId>bjk-core-api</UserSecretsId>
    <!-- The modules' XML comments, so the API reference and the generated client carry their descriptions. -->
    <CopyDocumentationFilesFromPackages>true</CopyDocumentationFilesFromPackages>
    <!--
      Regenerate the web app's API client after each Debug build (outside containers). Release builds only do it when
      asked: CI runs "-p:GenerateApiClient=true" and fails if the committed client is out of date.
    -->
    <GenerateApiClient Condition="'$(GenerateApiClient)' == '' And '$(Configuration)' == 'Debug' And '$(DOTNET_RUNNING_IN_CONTAINER)' != 'true'">true</GenerateApiClient>
    <!-- A failure only warns in Debug (e.g. before user secrets are set up), and stops the build otherwise. -->
    <ApiClientOnError Condition="'$(ApiClientOnError)' == '' And '$(Configuration)' == 'Debug'">WarnAndContinue</ApiClientOnError>
    <ApiClientOnError Condition="'$(ApiClientOnError)' == ''">ErrorAndStop</ApiClientOnError>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BJK.Modules.Media" />
    <PackageReference Include="BJK.Modules.Observability" />
    <PackageReference Include="BJK.Modules.Profiles" />
    <PackageReference Include="BJK.Modules.Posts" />
    <PackageReference Include="BJK.Modules.Notifications" />
    <PackageReference Include="BJK.Modules.Chat" />
    <PackageReference Include="BJK.Modules.Email" />
    <PackageReference Include="BJK.Modules.SMS" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="NSwag.AspNetCore" />
    <PackageReference Include="NSwag.MSBuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Update="nswag.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- See nswag.json. Writes src/web/src/lib/generated/api.ts. -->
  <Target Name="GenerateApiClient" AfterTargets="Build" Condition="'$(GenerateApiClient)' == 'true'">
    <Exec ContinueOnError="$(ApiClientOnError)" WorkingDirectory="$(MSBuildProjectDirectory)" EnvironmentVariables="ASPNETCORE_ENVIRONMENT=Development;GeneratingApiClient=true" Command="$(NSwagExe_Net100) run nswag.json /variables:Configuration=$(Configuration)" />
  </Target>

</Project>
