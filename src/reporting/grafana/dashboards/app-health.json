{
  "uid": "bjk-app-health",
  "title": "App health",
  "description": "Requests, errors, slow endpoints and logs for the identity server, API and media worker, from OpenTelemetry (the local otel-lgtm container, or Grafana Cloud when deployed).",
  "tags": [
    "bad-jockeys"
  ],
  "timezone": "Europe/London",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Requests",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Requests per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Server errors (5xx) per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "description": "Should stay at 0.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$service\", http_response_status_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Slowest endpoints (95th percentile)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "description": "The five slowest routes. Most should be well under a second.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "topk(5, histogram_quantile(0.95, sum by (le, job, http_route) (rate(http_server_request_duration_seconds_bucket{job=~\"$service\", http_route!=\"\"}[$__rate_interval]))))",
          "legendFormat": "{{job}} {{http_route}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "title": "Errors and warnings logged",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "sum by (service_name, severity_text) (count_over_time({service_name=~\"$service\"} | severity_text=~\"(?i)error|critical|fatal|warning\" [$__auto]))",
          "legendFormat": "{{service_name}} {{severity_text}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Failed jobs and queues",
      "type": "table",
      "datasource": {
        "type": "mssql",
        "uid": "bjk-app"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "description": "From the database. Failed should stay at 0.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "bjk-app"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT Queue, Kind, Messages FROM reporting.QueueBacklog"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 8,
      "title": "Latest errors",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 12
      },
      "description": "Click a line for its details; a trace id opens the request's trace.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "{service_name=~\"$service\"} | severity_text=~\"(?i)error|critical|fatal\"",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "metrics",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Metrics",
          "value": "bjk-metrics"
        },
        "hide": 0
      },
      {
        "name": "logs",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "Logs",
          "value": "bjk-logs"
        },
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "bjk-identity-server,bjk-core-api,bjk-media-worker,bjk-web",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Other dashboards",
      "type": "dashboards",
      "tags": [
        "bad-jockeys"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    }
  ]
}