{
  "uid": "bjk-identity-server",
  "title": "Identity server",
  "description": "Accounts, sign-ups, sign-in methods, age checks and staff roles. Counts only: no emails or personal details.",
  "tags": [
    "bad-jockeys"
  ],
  "timezone": "Europe/London",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "refresh": "5m",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Accounts",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Accounts now",
      "type": "stat",
      "datasource": {
        "type": "mssql",
        "uid": "bjk-idsrv"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 5
      },
      "description": "Every account in the identity server now. Deleted accounts are gone entirely after their 90 days.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "bjk-idsrv"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT Accounts, Active, Deactivated, EmailConfirmed AS [Email confirmed], TwoStepOn AS [Two-step on], LockedOut AS [Locked out], AgeChecked AS [Age-checked], UnderEighteen AS [Under 18] FROM reporting.AccountSummary"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Sign-ups per day",
      "type": "timeseries",
      "datasource": {
        "type": "mssql",
        "uid": "bjk-idsrv"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "bjk-idsrv"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT CAST(Day AS datetime2) AS time, SignUps AS [Sign-ups] FROM reporting.SignUpsByDay WHERE $__timeFilter(Day) ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "barAlignment": 0,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "title": "Deactivations per day",
      "type": "timeseries",
      "datasource": {
        "type": "mssql",
        "uid": "bjk-idsrv"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "description": "Accounts deactivated by their owner or a moderator; they're deleted after 90 days unless reactivated.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "bjk-idsrv"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT CAST(Day AS datetime2) AS time, Deactivations FROM reporting.DeactivationsByDay WHERE $__timeFilter(Day) ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "barAlignment": 0,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Who and how",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "title": "Age bands",
      "type": "barchart",
      "datasource": {
        "type": "mssql",
        "uid": "bjk-idsrv"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 8,
        "h": 9
      },
      "description": "From the declared date of birth. 13 is the minimum age.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "bjk-idsrv"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT Band, Accounts FROM reporting.AgeBands ORDER BY SortOrder"
        }
      ],
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": 0,
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#00B5E5"
          },
          "min": 0,
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "How people sign in",
      "type": "piechart",
      "datasource": {
        "type": "mssql",
        "uid": "bjk-idsrv"
      },
      "gridPos": {
        "x": 8,
        "y": 15,
        "w": 8,
        "h": 9
      },
      "description": "Password only, or a linked Google, Apple or Facebook account (someone with two linked accounts counts twice).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "bjk-idsrv"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT Method, Accounts FROM reporting.SignInMethods ORDER BY Accounts DESC"
        }
      ],
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        },
        "displayLabels": []
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Age checks (for sensitive posts)",
      "type": "table",
      "datasource": {
        "type": "mssql",
        "uid": "bjk-idsrv"
      },
      "gridPos": {
        "x": 16,
        "y": 15,
        "w": 8,
        "h": 9
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "bjk-idsrv"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT Status, Method, Accounts FROM reporting.AgeChecks ORDER BY Accounts DESC"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Staff and health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "title": "Staff roles",
      "type": "table",
      "datasource": {
        "type": "mssql",
        "uid": "bjk-idsrv"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 6
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "bjk-idsrv"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT Role, People FROM reporting.StaffRoles ORDER BY Role"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Account changes waiting to reach the app",
      "type": "stat",
      "datasource": {
        "type": "mssql",
        "uid": "bjk-idsrv"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 6
      },
      "description": "Deactivations, reactivations and deletions saved here but not yet sent to bjk-core. It should stay at 0; a growing number means the queue isn't being delivered.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "bjk-idsrv"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT Waiting FROM reporting.OutboxBacklog"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Waiting"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Other dashboards",
      "type": "dashboards",
      "tags": [
        "bad-jockeys"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    }
  ]
}