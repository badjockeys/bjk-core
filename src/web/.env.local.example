# Settings for the web app on your machine. Copy to .env.local (git-ignored) and fill in the blanks.
# In Azure the same names are container settings, with secrets from Key Vault. Nothing here reaches the browser.

# The address you open in the browser. Sign-in redirects, links and preview cards use it.
APP_URL=http://localhost:3000

# The bjk-core API (src/BJK.Core.Api). Use its http profile locally, so Node.js doesn't need the dev certificate.
API_BASE_URL=http://localhost:5100

# The identity server (bjk-identity-server) and this app's client there. The secret is Clients:Web:Secret in the
# identity server's user secrets ("local-web-secret" in its template).
IDSRV_AUTHORITY=https://localhost:5001
IDSRV_CLIENT_ID=bjk-web
IDSRV_CLIENT_SECRET=local-web-secret
# Optional. The default asks for everything the web app uses (bjk.users is for "Download your data").
# IDSRV_SCOPES=openid profile email offline_access bjk.profiles bjk.posts bjk.media bjk.users
# Only for an http:// stand-in identity server (the end-to-end tests). Never true in real environments.
# IDSRV_ALLOW_HTTP=false

# Encrypts the session cookie that holds the user's tokens. At least 32 characters: openssl rand -base64 32
AUTH_SECRET=

# Cloudflare Turnstile site key for the public report form. 1x00000000000000000000AA is Cloudflare's test key,
# which always passes and pairs with the test secret key the API uses locally.
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Where photos and videos are shown from (the public bucket), and where the browser uploads to (signed links to the
# originals bucket). Comma-separated origins, for the Content-Security-Policy. Locally both are S3Mock.
MEDIA_ORIGINS=http://localhost:9090
UPLOAD_ORIGINS=http://localhost:9090

# Map tiles for dropping the incident pin. OpenStreetMap's tiles are fine for development; use a tile provider
# with an agreement (or self-hosted tiles) before launch.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=© OpenStreetMap contributors
