# GO-LIVE CHECKLIST for the web app. Not used on your machine (that's .env.local, from .env.local.example).
# In Azure these are container settings; the SECRET ones come from Key Vault. Replace every <GO-LIVE ...> value.

APP_URL=<GO-LIVE: the public address, e.g. https://badjockeys.com>
API_BASE_URL=<GO-LIVE: the API, e.g. https://api.badjockeys.com>

IDSRV_AUTHORITY=<GO-LIVE: the identity server, e.g. https://auth.badjockeys.com>
IDSRV_CLIENT_ID=bjk-web
# SECRET: must match Clients:Web:Secret in the identity server's settings.
IDSRV_CLIENT_SECRET=<GO-LIVE SECRET: a long random string>
# Never true outside the end-to-end tests.
IDSRV_ALLOW_HTTP=false

# SECRET: encrypts the session cookie. openssl rand -base64 32. Changing it signs everyone out.
AUTH_SECRET=<GO-LIVE SECRET>

# The real Turnstile widget's site key (its secret key goes in the API's Captcha:TurnstileSecretKey).
TURNSTILE_SITE_KEY=<GO-LIVE: Cloudflare Turnstile site key>

# The public media domain, and the R2 endpoint the browser uploads to with signed links.
MEDIA_ORIGINS=<GO-LIVE: e.g. https://media.badjockeys.com>
UPLOAD_ORIGINS=<GO-LIVE: https://<cloudflare account id>.r2.cloudflarestorage.com>

# OpenStreetMap's public tiles aren't allowed for heavy production use: pick a tile provider (or self-host).
MAP_TILE_URL=<GO-LIVE: the provider's tile URL with {z}/{x}/{y} (and its key, if any)>
MAP_ATTRIBUTION=<GO-LIVE: the provider's required attribution>
