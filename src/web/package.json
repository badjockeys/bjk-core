{
  "name": "bjk-web",
  "version": "0.1.0",
  "private": true,
  "description": "The Bad Jockeys web app (Next.js).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
