{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Set up (one-off)",
      "detail": "scripts/setup-local.mjs: config files, Docker, user secrets, models, build",
      "type": "shell",
      "command": "node scripts/setup-local.mjs",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Run Bad Jockeys",
      "detail": "Starts Docker if needed, then the identity server, API, media worker and web app, each in its own terminal",
      "dependsOn": [
        "Start Docker services",
        "Start all apps"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Start all apps",
      "dependsOn": [
        "Identity server",
        "API",
        "Media worker",
        "Web app"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "hide": true
    },
    {
      "label": "Identity server",
      "type": "shell",
      "command": "dotnet run --project src/BJK.Idsrv.Host --launch-profile https",
      "options": {
        "cwd": "${workspaceFolder}/../bjk-identity-server"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "bjk",
        "reveal": "always"
      }
    },
    {
      "label": "API",
      "type": "shell",
      "command": "dotnet run --project src/BJK.Core.Api --launch-profile https",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "bjk",
        "reveal": "always"
      }
    },
    {
      "label": "Media worker",
      "type": "shell",
      "command": "dotnet run --project src/BJK.Core.MediaWorker --launch-profile worker",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "bjk",
        "reveal": "always"
      }
    },
    {
      "label": "Web app",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/src/web",
        "env": {
          "NODE_EXTRA_CA_CERTS": "${userHome}/.aspnet/dev-cert.pem"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "bjk",
        "reveal": "always"
      }
    },
    {
      "label": "Stop Docker services",
      "type": "shell",
      "command": "docker compose stop",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "Stop SQL Server"
      ],
      "problemMatcher": []
    },
    {
      "label": "Stop SQL Server",
      "type": "shell",
      "command": "docker compose stop",
      "options": {
        "cwd": "${workspaceFolder}/../bjk-identity-server"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "Start Docker services",
      "detail": "Opens Docker Desktop if needed, then starts SQL Server and S3Mock",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/start-docker.mjs"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
