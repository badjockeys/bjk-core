<Project>
  <!-- Central package management: versions live here, projects reference packages without a Version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets the pins below override versions that dependencies pull in. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Bad Jockeys modules, from GitHub Packages (bjk-modules). Keep them on the same version. -->
    <PackageVersion Include="BJK.Modules.Media" Version="0.2.0-ci.126" />
    <PackageVersion Include="BJK.Modules.Profiles" Version="0.2.0-ci.126" />
    <PackageVersion Include="BJK.Modules.Posts" Version="0.2.0-ci.126" />
    <PackageVersion Include="BJK.Modules.Notifications" Version="0.2.0-ci.126" />
    <PackageVersion Include="BJK.Modules.Email" Version="0.2.0-ci.126" />
    <PackageVersion Include="BJK.Modules.SMS" Version="0.2.0-ci.126" />

    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <!-- API reference: the OpenAPI document and Swagger UI, generated from the controllers at run time. -->
    <PackageVersion Include="NSwag.AspNetCore" Version="14.6.3" />
    <!-- Generates the web app's API client (src/web/src/lib/generated/api.ts) from the same document. Keep in step. -->
    <PackageVersion Include="NSwag.MSBuild" Version="14.6.3" />

    <!-- Security pins for packages we only get indirectly. Remove once dependencies ship the fix themselves. -->
    <!-- CVE-2026-70162 (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx): fixed in 10.0.13. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
